  <Flow>
    <Routine name="Welcome"/>
    <LoopInitiator loopType="TrialHandler" name="run1">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="None" valType="str"/>
      <Param name="conditionsFile" updates="None" val="" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="run1" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="Fix_start"/>
    <LoopInitiator loopType="TrialHandler" name="blocks1">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[{'condsFile': 'block_1_semantic_original_A.csv', 'msg': 'see some semantic stuff'}, {'condsFile': 'fix.xlsx', 'msg': 'look at fixation'}, {'condsFile': 'block_2_non-semantic_original_A.csv', 'msg': 'see some non-semantic stuff'}, {'condsFile': 'fix.xlsx', 'msg': 'look at fixation'}, {'condsFile': 'block_1_semantic_original_A.csv', 'msg': 'see some semantic stuff'}, {'condsFile': 'fix.xlsx', 'msg': 'look at fixation'}, {'condsFile': 'block_2_non-semantic_original_A.csv', 'msg': 'see some non-semantic stuff'}]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="block1A.xlsx" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="blocks1" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="readyMsg"/>
    <LoopInitiator loopType="TrialHandler" name="trials1">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="None" valType="str"/>
      <Param name="conditionsFile" updates="None" val="$condsFile" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="trials1" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="judgement"/>
    <LoopTerminator name="trials1"/>
    <LoopTerminator name="blocks1"/>
    <Routine name="fix_end"/>
    <LoopTerminator name="run1"/>
    <Routine name="Memory_Instr"/>
    <LoopInitiator loopType="TrialHandler" name="trials_4">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="None" valType="str"/>
      <Param name="conditionsFile" updates="None" val="" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="num"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="loopType" updates="None" val="random" valType="str"/>
      <Param name="nReps" updates="None" val="1" valType="num"/>
      <Param name="name" updates="None" val="trials_4" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="OldNew"/>
    <Routine name="confidence"/>
    <LoopTerminator name="trials_4"/>
    <Routine name="Theend"/>
  </Flow>
</PsychoPy2experiment>
